{
  "compilerOptions": {
    "outDir": "./dist/",
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "module": "commonjs",
    "moduleResolution": "Node",
    "target": "es6",
    "sourceMap": true,
    "lib": ["es2017", "dom"],
    "esModuleInterop": true
  },
  "include": ["./src/**/*"]
}
